    "/files/upload": {
      "post": {
        "description": "Uploads a file to the specified cloud storage provider (Dropbox, OneDrive, or Google Drive). The user must have previously connected their account for the selected provider.",
        "operationId": "FilesController_uploadToCloudStorage",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "File to upload with storage type",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "File to upload (max 10MB)"
                  },
                  "storageType": {
                    "type": "string",
                    "enum": [
                      "dropbox",
                      "onedrive",
                      "googledrive",
                      "email"
                    ],
                    "description": "Cloud storage provider or email"
                  }
                },
                "required": [
                  "file",
                  "storageType"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "response": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid file or missing parameters"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing access token"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Upload file to cloud storage",
        "tags": [
          "files"
        ]
      }
    },
    "/files/upload-to-dropbox": {
      "post": {
        "description": "DEPRECATED: Use /upload with storageType parameter instead. Uploads a PDF file to the authenticated user's Dropbox account.",
        "operationId": "FilesController_uploadToDropbox",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "PDF file to upload",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF file to upload (max 10MB)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully to Dropbox",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "dropboxResponse": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "path_lower": {
                          "type": "string"
                        },
                        "size": {
                          "type": "number"
                        },
                        "server_modified": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid file or missing Dropbox token"
          },
          "401": {
            "description": "User not authenticated or invalid Dropbox token"
          },
          "500": {
            "description": "Dropbox upload failed"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Upload PDF to user's Dropbox (deprecated)",
        "tags": [
          "files"
        ]
      }
    },
    "/files/dropbox-files": {
      "post": {
        "description": "Returns a list of files uploaded to the user's Dropbox Scanned Documents folder",
